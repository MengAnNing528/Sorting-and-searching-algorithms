 int target = 7; // Искомое значение
 
 // Вызываем функцию поиска
 int result = linearSearch(array, size, target);
 
 // Выводим результат
 if(result != -1) {
 cout << «Элемент найден на позиции: « << result << endl;
 } else {
 cout << «Элемент не найден» << endl;
 }
 
